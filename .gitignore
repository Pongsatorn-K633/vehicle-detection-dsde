*.pt
*.pth
*.onnx
!weights/**

# Weight zips from Google Drive (unzip into runs/)
*.zip

# Claude Code
*.claude/

# Python / notebooks
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Editor
.vscode/

